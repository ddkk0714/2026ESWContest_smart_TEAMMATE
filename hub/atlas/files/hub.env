# DESKMATE Pi 4 hub service runtime settings. Installed next to the executable; the service reads it at start.
# Change on the board without rebuilding:  scp hub.env atlas:/data/share/usr/atlas/services/com.deskmate.hub1/  then
#   ssh atlas 'kill $(pidof deskmate_hub_service)'  (D-Bus re-activates it on the next call / HTTP request)
DESKMATE_HUB_MODE=live            # live = UART + MQTT sensors -> FSM ; demo = synthetic scenario (HTTP screen test)
DESKMATE_MQTT_HOST=172.16.34.176  # broker. Pipeline test: PC broker behind the ASUS router (WAN IP), port-forward 1883
DESKMATE_MQTT_PORT=1883
DESKMATE_UART_DEV=/dev/serial0    # ESP32 UART2 (GPIO14/15). Needs serial-getty@ttyS0 stopped on the board
DESKMATE_UART_BAUD=115200
