# deskmate_tofposture 설정 (KEY=VALUE). start.sh 가 처음에 tofposture.env 로 복사한다.
# 센서 입력: 비우면 /dev/ttyUSB* /dev/ttyACM* 를 이름순으로 최대 4개 자동.
#   USB 가 안 보이면 PC 에서 tof_live.py --forward 로 넘기고 여기에 tcp:9001,tcp:9002 를 쓴다.
#   운영(UART2 TYPE 0x05, hub/atlas 중계)이면 tcp:9100 하나 — 두 센서가 한 연결로 오고 센서 번호로 나뉜다.
TOFPOSTURE_PORTS=
# auto = 921600 → 115200 → 460800 → 230400 중 센서 줄이 읽히는 값. 알면 숫자로 고정
TOFPOSTURE_BAUD=auto
# 장치 위치(설치 화면에서 고름: left·center·right)별 모델. 비우면 기능 꺼짐. 지금은 셋 다 같은 모델로 자리만 잡아 둔다 —
# PC 가 위치별 모델을 주면 models/<이름>_left/posture_net.bin 식으로 경로만 바꾼다. 고른 위치는 placement.txt 에 남아 다음 시작 때 우선
TOFPOSTURE_PLACEMENT_MODELS=left=models/opt_l8_c256/posture_net.bin,center=models/opt_l8_c256/posture_net.bin,right=models/opt_l8_c256/posture_net.bin
TOFPOSTURE_PLACEMENT_FILE=placement.txt
TOFPOSTURE_HTTP=8771
TOFPOSTURE_BIND=0.0.0.0
# 센서 원본 격자 GET /raw 두 번째 리스너 (uart_relay_board 가 내던 8772 자리, Pi 5 개발자 화면 ToF 열지도). 0 = 끔
TOFPOSTURE_RAW_HTTP=8772
TOFPOSTURE_FUSION=logprob
# 장착 방향 보정 (tof_live.py --show 로 확인한 값). 1 = 뒤집기, 0 = 안 뒤집기,
# 비우면 자동: UART 0x05 는 펌웨어 flags(b2/b3, 조립 때 정한 값)대로, USB·PC 경로는 안 뒤집음
TOFPOSTURE_FLIP_ROWS=
TOFPOSTURE_FLIP_COLS=
# GRU 은닉 상태 리셋 (PC 시뮬 10-24 정의). 둘 다 기본 0 = 끔. 주기: 시뮬 36개에서 900 은 전체 효과 없음.
# 자리 비움: 시뮬 180회(보드 모델 v4)에서 복귀 뒤 정확도 끔 0.790 / 60 s 0.633 — 실기에서 은닉 상태 고착이 보이면 300 s
TOFPOSTURE_RESET_PERIOD_S=0
TOFPOSTURE_AWAY_RESET_S=0
# 재실 판정: status 5·6·9·10 이고 거리 [MIN,MAX] mm 인 zone 비율이 두 센서 중 어느 쪽이든 MIN_COVERAGE 이상이면 재실
TOFPOSTURE_PRESENT_MIN_MM=150
TOFPOSTURE_PRESENT_MAX_MM=1300
TOFPOSTURE_PRESENT_MIN_COVERAGE=0.06
# 시연 경로(10-26 결정): 모델 입력 변환 + 엎드림 규칙 + upright 치환. 코드 기본은 전부 꺼짐(이전 동작).
# RADIAL: 유효 칸을 빔 방향 거리로(시뮬과 같게). FILL_NOTARGET_MM: status 255 칸을 3000 mm·status 5 로(왼쪽 자리의 빈 배경이 misplaced 과다 원인).
# FACEDOWN_RULE: 원본 격자 기하로 엎드림(약 0.65 m 설치에 맞춘 문턱 TOFPOSTURE_FD_*), 켜진 동안 face_down conf FD_CONF.
# SEATED_UPRIGHT: 모델 misplaced 인데 격자가 착석이면 upright. 근거·리플레이는 docs/FACEDOWN_RULE_REAL_20261026.md
TOFPOSTURE_RADIAL=1
TOFPOSTURE_FILL_NOTARGET_MM=3000
TOFPOSTURE_FACEDOWN_RULE=1
TOFPOSTURE_FD_CONF=0.995
TOFPOSTURE_SEATED_UPRIGHT=1
# misplaced 게이트(설치 베이스라인 ∧ 모델, 10-26 구현, 시연 경로 아님): off = 모델 그대로 / and = 모델 misplaced 이면서 베이스라인 대비
# 장치 이동이 10 s 이어질 때만 / never = misplaced 를 절대 표시 안 함. and 를 쓰면 설치 때 POST /api/baseline/capture
TOFPOSTURE_MISPLACED_RULE=off
TOFPOSTURE_BASELINE_FILE=baseline.json
TOFPOSTURE_BASELINE_CAPTURE_S=10
# 베이스라인 파일이 없을 때 첫 프레임부터 N s 자동 캡처(0 = 끔). 시연 준비 때 사람이 없는 상태로 켜면 편하다
TOFPOSTURE_BASELINE_AUTO_S=0
# 규칙 문턱: 배경 칸 = 베이스라인 거리 ≥ BG_MM, 변화 = max(MIN_MM, SIGMA×칸σ), 지금 유효한 배경 칸 중 변한 비율 ≥ FRAC 이 HOLD_S 유지
TOFPOSTURE_BASELINE_BG_MM=1200
TOFPOSTURE_MOVED_MIN_MM=80
TOFPOSTURE_MOVED_SIGMA=4
TOFPOSTURE_MOVED_FRAC=0.5
TOFPOSTURE_MOVED_HOLD_S=10
TOFPOSTURE_STDOUT=change
