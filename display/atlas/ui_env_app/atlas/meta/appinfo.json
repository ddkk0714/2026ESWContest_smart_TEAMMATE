{
    "id": "com.deskmate.uienv",
    "type": "flutter",
    "name": "UI ENV",
    "description": "DESKMATE environment UI development app",
    "entry": "deskmate_ui_env --bundle=./ --fullscreen -a com.deskmate.uienv",
    "version": "0.1.0",
    "required_permissions": {
        "privileged": [
            "com.atlas.permission.privileged.audiocontrol",
            "com.atlas.permission.privileged.mediacontrol",
            "com.atlas.permission.privileged.mediasession",
            "com.atlas.permission.privileged.permission_agent"
        ],
        "user_consent": [
            "com.atlas.permission.user_consent.mediaplayer"
        ]
    }
}
