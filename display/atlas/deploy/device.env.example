# Pi 5(ATLAS) 배포 대상 설정.
# 이 파일을 같은 폴더의 device.env 로 복사한 뒤 값을 채운다.
# device.env 와 SSH 키는 개발자마다 다르므로 커밋하지 않는다(.gitignore 대상).

# flutter-atlas 가 쓰는 장치 ID. 영숫자와 밑줄만 쓴다.
ATLAS_DEVICE_ID=deskmate_pi5

# flutter-atlas devices 목록에 표시될 이름.
ATLAS_DEVICE_LABEL=DESKMATE Pi 5

# Pi 5 의 IPv4 주소. DHCP 라면 보드 MAC 기준 예약 주소를 쓴다.
ATLAS_DEVICE_IP=192.168.0.100

# SSH 계정과 포트. ATLAS 이미지 기본값은 root / 22 다.
ATLAS_SSH_USER=root
ATLAS_SSH_PORT=22

# SSH 개인키 경로(레포 루트 기준 상대 경로).
# 비워두면 비밀번호 인증을 쓴다. 배포 한 번에 SSH 를 여러 번 호출하므로 키 인증을 권장한다.
ATLAS_SSH_KEY=display/atlas/deploy/ssh/id_deskmate

# 빌드할 Atlas Flutter 앱 폴더(레포 루트 기준 상대 경로).
# Docker 는 레포 밖 경로를 마운트하지 않으므로 앱도 레포 안에 있어야 한다.
# 앱 ID 는 그 폴더의 atlas/meta/appinfo.json 이 정한다.
# ID 가 다른 빌드는 보드에 나란히 설치되므로 기존 앱을 지우지 않고 비교할 수 있다.
ATLAS_APP_DIR=display/atlas/app

# Pi 4 hub 상태 API 주소. 비워두면 화면 내장 데모가 순환한다.
# 값이 있으면 --dart-define=DESKMATE_HUB_URL 로 빌드에 전달된다.
ATLAS_HUB_URL=

# 자세 화면이 볼 Pi 4 자세 노드 주소. 허브와 다른 값이고, 보통은 비워 둔다 —
# 비어 있어야 같은 보드의 camsvc → ESP32-CAM 직결 순으로 내려간다.
# 값이 있으면 --dart-define=DESKMATE_POSTURE_URL 로 전달된다.
ATLAS_POSTURE_URL=

# 기본 빌드 모드: release | debug | profile
ATLAS_BUILD_MODE=release
