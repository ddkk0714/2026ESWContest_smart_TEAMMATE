[
  {
    "id": "deskmate-monitor-tab",
    "type": "tab",
    "label": "DESKMATE 통신 모니터",
    "disabled": false,
    "info": "Pi 4 MQTT broker를 구독하는 개발용 모니터입니다. 제품 FSM 경로에는 포함하지 않습니다."
  },
  {
    "id": "deskmate-note",
    "type": "comment",
    "z": "deskmate-monitor-tab",
    "name": "실제 경로: ESP32 ─ UART/CRC-16 ─ Pi 4 ─ Ethernet/MQTT ─ Pi 5",
    "info": "Node-RED는 PC에서 MQTT를 관찰하고 합성 메시지를 주입하는 개발 도구입니다.",
    "x": 370,
    "y": 60,
    "wires": []
  },
  {
    "id": "pi4-mqtt-broker",
    "type": "mqtt-broker",
    "name": "Pi 4 MQTT broker (준비 중)",
    "broker": "172.16.34.146",
    "port": "1883",
    "clientid": "deskmate-pc-monitor",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "5",
    "keepalive": "30",
    "cleansession": true,
    "autoUnsubscribe": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "birthMsg": {},
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "closeMsg": {},
    "willTopic": "",
    "willQos": "0",
    "willPayload": "",
    "willMsg": {},
    "userProps": "",
    "sessionExpiry": ""
  },
  {
    "id": "mqtt-live-in",
    "type": "mqtt in",
    "z": "deskmate-monitor-tab",
    "name": "Pi 4 실시간 MQTT 수신",
    "topic": "deskmate/#",
    "qos": "1",
    "datatype": "auto-detect",
    "broker": "pi4-mqtt-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 180,
    "y": 140,
    "wires": [["live-format"]]
  },
  {
    "id": "live-format",
    "type": "function",
    "z": "deskmate-monitor-tab",
    "name": "수신 시각·topic 표시",
    "func": "msg.payload = { received_at: new Date().toISOString(), topic: msg.topic, payload: msg.payload }; return msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 410,
    "y": 140,
    "wires": [["live-debug"]]
  },
  {
    "id": "live-debug",
    "type": "debug",
    "z": "deskmate-monitor-tab",
    "name": "실시간 수신",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "topic",
    "statusType": "msg",
    "x": 650,
    "y": 140,
    "wires": []
  },
  {
    "id": "demo-state-inject",
    "type": "inject",
    "z": "deskmate-monitor-tab",
    "name": "데모: Pi 4 상태 발행",
    "props": [
      { "p": "topic", "vt": "str" },
      { "p": "payload", "v": "{\"schema_version\":\"1.0\",\"ts\":1788508800.0,\"node\":\"hub\",\"boot_id\":\"node-red-demo\",\"seq\":1,\"data\":{\"fsm_state\":\"FOCUS_PC\",\"phase\":\"focus\",\"context\":\"pc\",\"c_focus\":0.22,\"c_fatigue\":0.18,\"confidence\":0.88,\"source\":\"fsm\",\"gate\":\"none\",\"reasons\":[\"node_red_demo\"],\"sensor_summary\":{\"present\":true,\"co2_ppm\":720,\"lux\":410,\"valid\":true}}}", "vt": "json" }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "deskmate/state/phase",
    "x": 190,
    "y": 240,
    "wires": [["demo-format", "pi4-mqtt-out"]]
  },
  {
    "id": "demo-feedback-inject",
    "type": "inject",
    "z": "deskmate-monitor-tab",
    "name": "데모: Pi 5 수락 피드백",
    "props": [
      { "p": "topic", "vt": "str" },
      { "p": "payload", "v": "{\"schema_version\":\"1.0\",\"ts\":1788508800.0,\"node\":\"display\",\"boot_id\":\"node-red-demo\",\"seq\":2,\"data\":{\"request_id\":\"node-red-demo\",\"verdict\":\"accept\",\"response_ms\":0}}", "vt": "json" }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "deskmate/feedback/user",
    "x": 200,
    "y": 300,
    "wires": [["demo-format", "pi4-mqtt-out"]]
  },
  {
    "id": "demo-format",
    "type": "function",
    "z": "deskmate-monitor-tab",
    "name": "데모 메시지 표시",
