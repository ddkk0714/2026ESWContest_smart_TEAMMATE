# Root-owned shell configuration; no secrets.
ROLE=pi4
SERVICE_DIR=/data/share/usr/atlas/services/com.deskmate.hub1
DBUS_DIR=/data/share/usr/share/dbus-1
BROKER_DIR=/data/share/deskmate/bin
UART_DEV=/dev/serial0
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
APP_ID=com.atlas.app.deskmate_display
HUB_URL=http://127.0.0.1:8765
CHECK_FAILURES=3
RECOVERY_COOLDOWN_SEC=120
SUPERVISE_POLL_SEC=5
STATE_DIR=/run/deskmate-recovery
