PRIMARY_SERVICE, GAP_SERVICE
CHARACTERISTIC, GAP_DEVICE_NAME, READ, "DESKMATE-FAN"

PRIMARY_SERVICE, GATT_SERVICE
CHARACTERISTIC, GATT_DATABASE_HASH, READ,

// DESKMATE fan service. Protocol: firmware/pico2w_ble_fan/README.md
PRIMARY_SERVICE, f1970001-51e1-4b0e-a7f1-8d27d8e34683
// command: binary <op> <arg> frames or ASCII text ("speed 60")
CHARACTERISTIC, f1970002-51e1-4b0e-a7f1-8d27d8e34683, WRITE | WRITE_WITHOUT_RESPONSE | DYNAMIC,
// state: [version, power, speed, level, mode, dir, timer_s lo, hi]
CHARACTERISTIC, f1970003-51e1-4b0e-a7f1-8d27d8e34683, READ | NOTIFY | DYNAMIC,
