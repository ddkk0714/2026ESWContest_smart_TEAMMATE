# Atlas 공급사 샘플은 Windows에서도 Git 검사에 걸리지 않도록 LF로 정규화한다.
display/atlas/app/atlas/** text eol=lf
display/atlas/camtest/atlas/** text eol=lf

# 컨테이너와 Pi 에서 실행되는 스크립트는 CRLF 로 체크아웃되면 shebang 이 깨진다.
*.sh text eol=lf

# stage2 피로 모델(portable CNN)은 바이트 지문(metadata.model_sha256)으로 검증한다 — Windows CRLF 변환이 끼면 보드에서 unavailable (10-25 실제로 발생).
hub/deskmate_hub/config/stage2/* -text
